# Preencha com senhas locais fortes e distintas.
POSTGRES_PASSWORD=
AI_QUERY_PASSWORD=

# Opcional. Primeiro dia após a janela de 12 meses, em YYYY-MM-01.
# Em branco, usa o primeiro dia do mês corrente na inicialização.
SEED_REFERENCE_DATE=

# Porta local do Swagger e da API.
AI_QUERY_API_PORT=8000
AI_QUERY_FRONTEND_PORT=5173

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
# Caminho do manifesto científico dentro do contêiner do backend.
# EVALUATION_SNAPSHOT_PATH=/app/evaluation/experimental_snapshot.json

# Necessárias somente com compose.langfuse.yaml. Gere valores distintos em hexadecimal.
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# 32 bytes em hexadecimal (64 caracteres), conforme a configuração oficial.
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_PORT=3000
LANGFUSE_MINIO_PORT=9090
# Obtenha as chaves nas configurações do projeto no Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# ID público do projeto no Langfuse, opcional para exibir links no frontend.
VITE_LANGFUSE_PROJECT_ID=
# Opcional quando o Langfuse é acessado por um endereço diferente de localhost.
# VITE_LANGFUSE_URL=http://localhost:3000
# Usadas por make setup para inicializar um Langfuse novo.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
